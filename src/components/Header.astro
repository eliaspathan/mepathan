---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <span class="brand-mark">M</span>
      <span>MePathan</span>
    </a>

    <nav>
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Articles</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: white;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    max-width: 1100px;
    margin: auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: .6rem;
    font-size: 1.3rem;
    font-weight: 800;
    color: #111827;
    text-decoration: none;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #2563eb;
    color: white;
    font-weight: 800;
  }

  nav {
    display: flex;
    gap: .25rem;
  }

  @media (max-width: 600px) {
    .header-inner {
      padding: .8rem 1rem;
    }

    nav {
      font-size: .92rem;
    }
  }
</style>
