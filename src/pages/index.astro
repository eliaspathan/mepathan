---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="hero-inner">
          <div>
            <span class="eyebrow">Analytics • Automation • Technology</span>

            <h1>
              Turn data into
              <span>better decisions.</span>
            </h1>

            <p>
              Practical tutorials and guides for Power BI, Power Automate,
              Power Apps, SQL, analytics, and modern business technology.
            </p>

            <div class="hero-buttons">
              <a class="primary" href="/blog">Explore Articles</a>
              <a class="secondary" href="/about">About MePathan</a>
            </div>
          </div>
        </div>
      </section>


      <section class="categories section">
        <div class="section-title">
          <span>Topics</span>
          <h2>What you'll find here</h2>
        </div>

        <div class="category-grid">
          <a href="/blog">
            <strong>📊 Power BI</strong>
            <span>Dashboards, DAX, modeling and analytics</span>
          </a>

          <a href="/blog">
            <strong>⚡ Power Automate</strong>
            <span>Workflow automation and integrations</span>
          </a>

          <a href="/blog">
            <strong>📱 Power Apps</strong>
            <span>Business apps and Power Platform solutions</span>
          </a>

          <a href="/blog">
            <strong>🗄️ Data & SQL</strong>
            <span>Queries, databases and data transformation</span>
          </a>
        </div>
      </section>


      <section class="section">
        <div class="posts-heading">
          <div class="section-title">
            <span>Latest</span>
            <h2>Recent Articles</h2>
          </div>

          <a href="/blog">View all →</a>
        </div>

        <div class="post-grid">
          {posts.map((post) => (
            <article class="post-card">
              <div class="post-placeholder">
                <span>MePathan</span>
              </div>

              <div class="post-content">
                <time>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                  })}
                </time>

                <h3>
                  <a href={`/blog/${post.id}/`}>
                    {post.data.title}
                  </a>
                </h3>

                <p>{post.data.description}</p>

                <a class="read-more" href={`/blog/${post.id}/`}>
                  Read article →
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: 100%;
  }

  .hero {
    background:
      radial-gradient(circle at 80% 20%, #dbeafe 0, transparent 35%),
      linear-gradient(135deg, #f8fafc, #eff6ff);
    border-bottom: 1px solid #e2e8f0;
  }

  .hero-inner {
    max-width: 1100px;
    margin: auto;
    padding: 6rem 1.25rem;
  }

  .hero-inner > div {
    max-width: 760px;
  }

  .eyebrow {
    display: inline-block;
    color: #2563eb;
    font-size: .85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -.04em;
    margin: 0;
    color: #0f172a;
  }

  h1 span {
    display: block;
    color: #2563eb;
  }

  .hero p {
    max-width: 650px;
    margin: 1.6rem 0 2rem;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #475569;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
  }

  .hero-buttons a {
    padding: .85rem 1.3rem;
    border-radius: 9px;
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    background: #2563eb;
    color: white;
  }

  .secondary {
    border: 1px solid #cbd5e1;
    color: #0f172a;
    background: white;
  }

  .section {
    max-width: 1100px;
    margin: auto;
    padding: 4rem 1.25rem;
  }

  .section-title span {
    color: #2563eb;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: .78rem;
    font-weight: 800;
  }

  .section-title h2 {
    margin: .35rem 0 1.5rem;
    font-size: 2rem;
    color: #0f172a;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .category-grid a {
    padding: 1.4rem;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    text-decoration: none;
    background: white;
    transition: .2s ease;
  }

  .category-grid a:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(15,23,42,.08);
  }

  .category-grid strong {
    display: block;
    color: #0f172a;
    margin-bottom: .5rem;
  }

  .category-grid span {
    color: #64748b;
    font-size: .9rem;
    line-height: 1.5;
  }

  .posts-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
  }

  .posts-heading > a {
    margin-bottom: 1.5rem;
    text-decoration: none;
    font-weight: 700;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .post-card {
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: white;
  }

  .post-placeholder {
    height: 170px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #1d4ed8, #60a5fa);
    color: white;
    font-weight: 800;
    font-size: 1.5rem;
  }

  .post-content {
    padding: 1.25rem;
  }

  time {
    color: #64748b;
    font-size: .8rem;
  }

  h3 {
    margin: .5rem 0;
    font-size: 1.3rem;
  }

  h3 a {
    color: #0f172a;
    text-decoration: none;
  }

  .post-content p {
    color: #64748b;
    line-height: 1.55;
    font-size: .95rem;
  }

  .read-more {
    display: inline-block;
    margin-top: .6rem;
    text-decoration: none;
    font-weight: 700;
    color: #2563eb;
  }

  @media (max-width: 800px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .post-grid {
      grid-template-columns: 1fr;
    }

    .hero-inner {
      padding: 4rem 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
